NODE_ENV=development
PORT=4002
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_DIALECT=mysql

FILEPATH=$../../public
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4002

SYS_EMAIL=your-email@example.com
SYS_EMAIL_PASSWORD=your-email-app-password

# WhatsApp order-status notifications (sent via Baileys, not Meta's Cloud API --
# see server/services/whatsApp.service.ts). All optional; sensible defaults apply
# if omitted.
WHATSAPP_ENABLED=true
WHATSAPP_DAILY_LIMIT=200
WHATSAPP_AUTH_DIR=baileys_auth
# Shared secret required as ?token=... to open the browser-based WhatsApp QR
# linking page (see server/controller/whatsAppStatus.controller.ts). Pick any
# long random string. Leave unset to disable that page entirely.
WHATSAPP_QR_ACCESS_TOKEN=your-long-random-string-here
